# Copy to .env and fill in. Never commit .env. See docs/deployment.md for every variable.
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000

# MongoDB Atlas, fundora_dev database for local work
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/fundora_dev

# openssl rand -base64 48
JWT_SECRET=
# openssl rand -base64 32  (back this up: losing it makes encrypted profile fields unreadable)
FIELD_ENCRYPTION_KEY=

# Email: resend or brevo. For local dev, `console` prints emails (and their links) to the terminal
# and needs no API key. `console` is refused when NODE_ENV=production.
EMAIL_PROVIDER=console
EMAIL_API_KEY=
EMAIL_FROM="Fundora <hello@example.com>"
TEAM_INBOX=team@example.com

# Optional
# Google sign-in: the OAuth client ID (ends in .apps.googleusercontent.com). No client secret needed.
GOOGLE_CLIENT_ID=
SENTRY_DSN=

# Client (public, baked into the build; never put secrets here)
VITE_USE_MOCK_DATA=true
# Leave empty to use GOOGLE_CLIENT_ID
VITE_GOOGLE_CLIENT_ID=
VITE_POSTHOG_KEY=

# MongoDB MCP server for Claude Code: set this in your shell, not here.
# MDB_MCP_CONNECTION_STRING=mongodb+srv://DEV_USER:PASSWORD@CLUSTER.mongodb.net/fundora_dev
