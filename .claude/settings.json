{
  "permissions": {
    "allow": [
      "Bash(npm run lint)",
      "Bash(npm run typecheck)",
      "Bash(npm test)",
      "Bash(npm run test:*)",
      "Bash(npm run validate-schemes)",
      "Bash(npm run check-scheme:*)",
      "Bash(npm run build)",
      "Bash(git status)",
